[Unit]
Description=Recover Android HALs after the early-boot binder race (ginna)
After=lxc-android-config.service android-container.service
Before=lightdm.service

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=180
ExecStart=/usr/local/bin/halium-hal-recover

[Install]
WantedBy=multi-user.target
