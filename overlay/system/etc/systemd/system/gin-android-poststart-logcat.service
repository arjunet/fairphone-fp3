# Temporary Moto E 2020 (ginna) Android post-start diagnostic.
# Runs only after lxc-android-config.service has started Android LXC.
# Saves a one-shot Android service/logcat snapshot on userdata for TWRP retrieval.

[Unit]
Description=Capture ginna Android LXC post-start service diagnostic
Requires=lxc-android-config.service
After=lxc-android-config.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'LOG=/userdata/gin-android-poststart.log; { echo; echo "============================================================"; echo "=== ginna Android post-start diagnostic ==="; date -u "+%%Y-%%m-%%dT%%H:%%M:%%SZ"; echo "--- Android container device probe ---"; /usr/bin/lxc-attach -n android -- /system/bin/sh -c "id; ls -l /dev/qseecom 2>&1 || true; mount | grep -i qsee || true"; echo "--- Android service-manager status ---"; /usr/bin/lxc-attach -n android -- /system/bin/sh -c "service list 2>&1 || true; lshal 2>&1 || true"; echo "--- Android logcat snapshot ---"; attempt=0; while [ $$attempt -lt 30 ]; do attempt=$$((attempt + 1)); /usr/bin/lxc-attach -n android -- /system/bin/logcat -b all -d -v threadtime && break; sleep 1; done; echo "=== end ginna Android post-start diagnostic ==="; } > "$$LOG" 2>&1'

[Install]
WantedBy=multi-user.target
