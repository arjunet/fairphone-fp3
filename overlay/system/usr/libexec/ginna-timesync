#!/usr/bin/env python3
"""ginna: set the system clock from the network.

systemd-timesyncd is broken on 32-bit armhf. The kernel attaches two
receive-timestamp control messages to every NTP reply (old 32-bit
SO_TIMESTAMPNS + new 64-bit one); timesyncd only reserves buffer space for
one, so every reply hits recvmsg() MSG_CTRUNC -> "Error receiving message,
disconnecting: Exchange full" and is discarded. The clock never syncs.
See systemd issue #38222 / PR #38251 (fixed in v258, not in Ubuntu 24.04's
255.4). This device also has no battery-backed RTC, so it boots at the
build-date floor and stays there.

The truncation only affects timesyncd's control-message handling, not SNTP
itself, so do a plain SNTP query here and step the clock with `date`. If
UDP/123 is unreachable, fall back to the Date header of an HTTPS response.
Always exits 0 so it can never wedge boot.

With --persist-until-synced (how device-hacks starts it at boot) it polls
every few seconds until the first successful sync of this boot, so the clock
is correct the instant WiFi connects in the OOBE wizard - no dependency on
network-online.target. Without the flag (the .timer's periodic re-run) it
does a single quick pass for drift correction.
"""
import fcntl
import os
import socket
import struct
import subprocess
import sys
import time
from email.utils import parsedate_to_datetime

RTC_DEV = "/dev/rtc0"
RTC_SET_TIME = 0x4024700A            # _IOW('p', 0x0a, struct rtc_time), 9 * int32

NTP_SERVERS = ["time.cloudflare.com", "time.google.com", "pool.ntp.org",
               "time.windows.com", "ntp.ubuntu.com"]
HTTPS_URLS = ["https://www.cloudflare.com/", "https://www.google.com/"]
NTP_UNIX_OFFSET = 2208988800          # seconds from 1900-01-01 to 1970-01-01
SANE_MIN = 1_750_000_000             # ~2025-06
SANE_MAX = 2_140_000_000             # ~2037-10
TIMESYNC_STAMP = "/var/lib/systemd/timesync/clock"


def log(*a):
    print("ginna-timesync:", *a, file=sys.stderr, flush=True)


def sntp_query(host, timeout=4):
    pkt = b"\x1b" + 47 * b"\0"        # LI 0, VN 3, Mode 3 (client)
    try:
        addrs = socket.getaddrinfo(host, 123, type=socket.SOCK_DGRAM)
    except OSError as e:
        log(f"{host}: resolve failed: {e}")
        return None
    for fam, _stype, _proto, _cn, sa in addrs:
        s = socket.socket(fam, socket.SOCK_DGRAM)
        s.settimeout(timeout)
        try:
            t0 = time.time()
            s.sendto(pkt, sa)
            data, _ = s.recvfrom(48)
            t3 = time.time()
        except OSError as e:
            log(f"{host} ({sa[0]}): {e}")
            continue
        finally:
            s.close()
        if len(data) < 48:
            continue
        mode = data[0] & 0x07
        stratum = data[1]
        xmit = struct.unpack("!Q", data[40:48])[0] / 2.0 ** 32 - NTP_UNIX_OFFSET
        if mode != 4 or stratum == 0 or stratum > 15:
            log(f"{host}: rejecting reply mode={mode} stratum={stratum}")
            continue
        srv_now = xmit + (t3 - t0) / 2.0
        if not (SANE_MIN < srv_now < SANE_MAX):
            log(f"{host}: implausible time {srv_now:.0f}")
            continue
        return srv_now
    return None


def https_query(url, timeout=8):
    import urllib.request
    try:
        req = urllib.request.Request(url, method="HEAD",
                                     headers={"User-Agent": "ginna-timesync"})
        with urllib.request.urlopen(req, timeout=timeout) as r:
            date_hdr = r.headers.get("Date")
    except Exception as e:
        log(f"{url}: {e}")
        return None
    if not date_hdr:
        return None
    try:
        ts = parsedate_to_datetime(date_hdr).timestamp()
    except Exception as e:
        log(f"{url}: unparseable Date {date_hdr!r}: {e}")
        return None
    return ts if SANE_MIN < ts < SANE_MAX else None


def seed_rtc(epoch):
    # Persist the time to the PMIC RTC so a future offline boot starts close
    # to right. Needs the DT patch (qcom,qpnp-rtc-write = 1); without it the
    # ioctl fails EACCES/EPERM, which is fine - just log it.
    tm = time.gmtime(epoch)            # the RTC keeps UTC
    rtc_time = struct.pack("9i", tm.tm_sec, tm.tm_min, tm.tm_hour,
                           tm.tm_mday, tm.tm_mon - 1, tm.tm_year - 1900,
                           0, 0, -1)
    try:
        fd = os.open(RTC_DEV, os.O_RDONLY)
    except OSError as e:
        log(f"{RTC_DEV}: {e}")
        return
    try:
        fcntl.ioctl(fd, RTC_SET_TIME, rtc_time)
        log("RTC seeded")
    except OSError as e:
        log(f"RTC write rejected ({e}); DT qcom,qpnp-rtc-write not enabled yet?")
    finally:
        os.close(fd)


def apply(epoch):
    # `date` (coreutils) handles the armhf 64-bit time_t layout correctly;
    # doing clock_settime() by hand from Python risks the same 32/64 struct
    # trap that bites everything else on this port.
    try:
        subprocess.run(["date", "-u", "-s", f"@{epoch:.3f}"],
                       check=True, stdout=subprocess.DEVNULL)
    except (OSError, subprocess.CalledProcessError) as e:
        log(f"date -s failed: {e}")
        return False
    # refresh timesyncd's recorded-timestamp floor so a future pre-network
    # boot starts from here instead of the image build date
    try:
        os.utime(TIMESYNC_STAMP, (epoch, epoch))
    except OSError:
        pass
    seed_rtc(epoch)
    return True


SYNCED_STAMP = "/run/ginna-timesync.synced"   # /run is cleared every boot
PERSIST_MAX_SEC = 45 * 60                     # give OOBE plenty of time to get on WiFi
PERSIST_POLL_SEC = 5


def try_once():
    """One quick pass: every NTP server, then the HTTPS fallback.
    Returns True as soon as the clock has been set (or we got a time but
    couldn't set it - that's still 'reached a source')."""
    for host in NTP_SERVERS:
        srv = sntp_query(host)
        if srv is None:
            continue
        skew = srv - time.time()
        if apply(srv):
            log(f"set from {host} (skew was {skew:+.1f}s) -> "
                f"{time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime(srv))}")
        else:
            log(f"got time from {host} but could not set the clock")
        return True

    for url in HTTPS_URLS:
        ts = https_query(url)
        if ts is None:
            continue
        skew = ts - time.time()
        if apply(ts):
            log(f"set from {url} Date header (skew was {skew:+.1f}s)")
        else:
            log(f"got time from {url} but could not set the clock")
        return True

    return False


def main():
    # --persist-until-synced: keep polling (cheap - a few UDP packets every few
    # seconds) until the first successful sync of this boot, so the clock is
    # right the instant WiFi comes up in the OOBE wizard, without depending on
    # network-online.target firing. A one-shot pass otherwise (the .timer's
    # hourly drift correction).
    persist = ("--persist-until-synced" in sys.argv[1:]
               and not os.path.exists(SYNCED_STAMP))

    deadline = time.time() + PERSIST_MAX_SEC
    announced_wait = False
    while True:
        if try_once():
            try:
                open(SYNCED_STAMP, "w").close()
            except OSError:
                pass
            return 0
        if not persist or time.time() >= deadline:
            log("no time source reachable"
                + (" within the persist window" if persist else ""))
            return 0
        if not announced_wait:
            log("no network yet - polling until synced")
            announced_wait = True
        time.sleep(PERSIST_POLL_SEC)


if __name__ == "__main__":
    sys.exit(main())
