#!/bin/sh
# ginna: install the preinstalled apps baked into the image
# (usr/libexec/ginna-preinstalled-clicks/*.click) that aren't on
# /opt/click.ubuntu.com yet.
#
# The .click files live under usr/libexec/, not usr/share/ - confirmed on
# 2026-09-14 that a brand-new usr/share/<name>/ directory never deploys
# through this device's overlay merge (only nested subdirectories *inside*
# an already-recognized tree like usr/libexec/ or usr/lib/systemd/system/
# reliably do; a new top-level sibling under usr/share/ does not, same as
# etc/default/ never deploying).
#
# A real `click install` writes click's own internal package-database state
# (.click/status, .click/available, .click/triggers/, lock files, the
# .click/info/<pkg>.manifest/.list/.md5sums click derives at install time) -
# genuine package-manager bookkeeping, not something safe to fake by hand-
# crafting a tarball at image-build time. So instead of baking in that
# expanded state directly, the image only ships the raw .click files, and
# this script runs the real `click install` + `click register` commands
# (proven working by hand: see the ginna app-preinstall session notes) the
# first time each app is missing. Idempotent - cheap no-op for anything
# already installed, safe to run every boot.
#
# ginna-click-resync (a separate, existing script) re-registers everything
# present under /opt/click.ubuntu.com on every boot, working around this
# device's framework-mismatch hook-stripping bug. This script runs early
# (from device-hacks, before any real user/D-Bus session exists), and
# confirmed on-device 2026-09-14: its own `click register` call is not
# enough by itself that early - the app installs fine (click list shows it)
# but its .desktop file never appears in the drawer. Only a *later* run of
# ginna-click-resync (after a real session exists) actually produces the
# .desktop file. So call it here too once anything's been installed or
# mirrored - it's cheap, idempotent, and gives a second, later-timed chance
# beyond whatever ginna-click-resync.service's own boot-time trigger manages
# on its own.
set -u

U=phablet
id "$U" >/dev/null 2>&1 || exit 0

did_install=0

# The official rootfs build preinstalls some apps (currently just
# notes.ubports) under /usr/share/click/preinstalled, which is part of the
# read-only rootfs. `click register` can never succeed there - confirmed
# on-device it needs to write a per-user marker into that same tree, and a
# bare .desktop-file copy isn't enough either (lomiri-app-launch validates
# the app ID against click's real registry and refuses to launch it: "Invalid
# app ID"). So mirror anything found there into the writable
# /opt/click.ubuntu.com instead, using the files click itself already
# generated at image-build time (not hand-crafted here) - then register it
# for real from the writable copy, exactly like every other app below.
PREINSTALLED=/usr/share/click/preinstalled
for cur in "$PREINSTALLED"/*/current; do
    [ -e "$cur" ] || continue
    pkg=$(basename "$(dirname "$cur")")
    ver=$(basename "$(readlink -f "$cur")")
    dest="/opt/click.ubuntu.com/$pkg/$ver"
    [ -e "$dest" ] && continue

    echo "ginna-preinstall-clicks: mirroring $pkg $ver from $PREINSTALLED"
    mkdir -p "/opt/click.ubuntu.com/$pkg"
    if cp -a "$PREINSTALLED/$pkg/$ver" "$dest" \
       && ln -sfn "$ver" "/opt/click.ubuntu.com/$pkg/current" \
       && chown -R clickpkg:clickpkg "/opt/click.ubuntu.com/$pkg" \
       && click register --user="$U" "$pkg" "$ver"; then
        echo "ginna-preinstall-clicks: $pkg $ver mirrored + registered"
        did_install=1
    else
        echo "ginna-preinstall-clicks: FAILED to mirror $pkg $ver"
    fi
done

SRC=/usr/libexec/ginna-preinstalled-clicks
if [ -d "$SRC" ]; then
    installed_pkgs=$(click list --user="$U" 2>/dev/null | awk '{print $1}')

    for click in "$SRC"/*.click; do
        [ -e "$click" ] || continue
        base=$(basename "$click" .click)
        pkg=${base%_*_*}
        rest=${base#${pkg}_}
        ver=${rest%_*}

        if echo "$installed_pkgs" | grep -qx "$pkg"; then
            continue
        fi

        echo "ginna-preinstall-clicks: installing $pkg $ver"
        if click install --user="$U" --allow-unauthenticated --force-missing-framework "$click" \
           && click register --user="$U" "$pkg" "$ver"; then
            echo "ginna-preinstall-clicks: $pkg $ver installed"
            did_install=1
        else
            echo "ginna-preinstall-clicks: FAILED $pkg $ver"
        fi
    done
fi

if [ "$did_install" = 1 ] && [ -x /usr/libexec/ginna-click-resync ]; then
    echo "ginna-preinstall-clicks: re-running ginna-click-resync for desktop hooks"
    /usr/libexec/ginna-click-resync
fi
exit 0
