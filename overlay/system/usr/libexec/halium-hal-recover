#!/bin/sh
# halium-hal-recover  (runs on the HOST, backgrounded from lxc-android-config's
# device-hacks)
#
# ginna has an intermittent early-boot binder-context race. Two flavours seen:
#
#  1. /dev/vndbinder: vndservicemanager starts before that binder context is
#     usable, fails BINDER_SET_CONTEXT_MGR, and never becomes the context
#     manager (stays "running" but does not own the node). handle-0 transactions
#     then return BR_DEAD_REPLY, the graphics composer can't keep
#     display.qservice alive, IComposer/default never registers -> black screen.
#
#  2. /dev/hwbinder: hwservicemanager itself loses the same race and crash-loops.
#     While it is down, every HIDL service's registerAsService() SIGABRTs, so the
#     whole HAL layer (composer, gralloc, configstore, sensors, ...) melts down
#     into "restarting". hwservicemanager.ready stays "true" (stale). UI never
#     comes up - stuck on the bootloader splash, though SSH works.
#
# init's own rapid auto-retries just hit -EBUSY on the not-yet-released
# binder_proc and never converge. A stop, a real gap, then a clean start works -
# verified by hand. Do that: bounce hwservicemanager first if it melted down,
# reset everything still crash-looping, then fix the composer/vndbinder path,
# then restart lightdm once.
#
# Always exits 0. Safe to run when nothing is wrong (it checks first).

CONTAINER=android
LXC="lxc-attach -n $CONTAINER --"

log()  { echo "halium-hal-recover: $*"; }
setp() { $LXC /system/bin/setprop "$1" "$2" 2>/dev/null; }
gp()   { $LXC /system/bin/getprop "$1" 2>/dev/null; }

composer_up() {
    # IComposer/default actually registered on hwbinder?
    timeout 20 $LXC /system/bin/lshal 2>/dev/null | grep -q 'IComposer/default'
}

restarting_list() {
    $LXC /system/bin/getprop 2>/dev/null \
        | grep '\]: \[restarting\]' \
        | sed -E 's/.*init\.svc\.([^]]+)\].*/\1/'
}
restarting_count() { restarting_list | grep -c . ; }

hwsm_ok() {
    [ "$(gp init.svc.hwservicemanager)" = "running" ] \
        && timeout 10 $LXC /system/bin/lshal >/dev/null 2>&1
}

relightdm=0

# 1. wait for the container
i=0
while ! lxc-info -n "$CONTAINER" >/dev/null 2>&1; do
    i=$((i + 1)); [ "$i" -ge 60 ] && { log "container never appeared"; exit 0; }
    sleep 1
done

# 2. wait until hwservicemanager.ready has been set once (proxy for "init got far
#    enough"); don't trust it beyond that - it never gets cleared.
i=0
while [ "$(gp hwservicemanager.ready)" != "true" ]; do
    i=$((i + 1)); [ "$i" -ge 60 ] && { log "hwservicemanager.ready never true; continuing anyway"; break; }
    sleep 1
done
sleep 3   # let init run its own class_start hal first

# 3. hwservicemanager meltdown recovery
if ! hwsm_ok || [ "$(restarting_count)" -ge 5 ]; then
    log "hwservicemanager unhealthy (state=$(gp init.svc.hwservicemanager) restarting=$(restarting_count)) - bouncing"
    setp ctl.stop hwservicemanager
    sleep 5                                    # let the dead binder_proc release
    setp ctl.start hwservicemanager
    i=0
    while [ "$(gp init.svc.hwservicemanager)" != "running" ]; do
        i=$((i + 1)); [ "$i" -ge 30 ] && { log "hwservicemanager still not running"; break; }
        sleep 1
    done
    sleep 3

    # reset every service still stuck in crash-backoff now that hwsm is healthy
    for round in 1 2 3; do
        svcs=$(restarting_list)
        [ -z "$svcs" ] && break
        log "reset round $round: $(echo "$svcs" | grep -c .) services still restarting"
        for s in $svcs; do setp ctl.stop  "$s"; done
        sleep 3
        for s in $svcs; do setp ctl.start "$s"; done
        sleep 8
    done
    log "after reset: restarting=$(restarting_count)"
    relightdm=1
fi

# 4. configstore specifically (also covers the case where only it is missing,
#    without a full meltdown)
if [ "$(gp init.svc.vendor.configstore-hal)" != "running" ]; then
    log "configstore not running - starting vendor.configstore-hal"
    $LXC /system/bin/start vendor.configstore-hal 2>/dev/null
    i=0
    while [ "$(gp init.svc.vendor.configstore-hal)" != "running" ]; do
        i=$((i + 1)); [ "$i" -ge 40 ] && { log "configstore never came up"; break; }
        sleep 0.5
    done
    relightdm=1
fi

# 5. composer / vndbinder path
if ! composer_up; then
    for attempt in 1 2 3 4; do
        log "attempt $attempt: cycling vndservicemanager + vendor.hwcomposer-2-1"
        setp ctl.stop  vendor.hwcomposer-2-1
        setp ctl.stop  vndservicemanager
        sleep 4                                # let the old binder_proc be released
        setp ctl.start vndservicemanager
        sleep 3
        setp ctl.start vendor.hwcomposer-2-1
        sleep 6
        if composer_up; then
            log "attempt $attempt: IComposer/default registered"
            break
        fi
    done
    relightdm=1
fi

# 6. hand the display back to lomiri
if composer_up; then
    if [ "$relightdm" = 1 ]; then
        log "recovered - restarting lightdm so the compositor picks up the HALs"
        systemctl restart lightdm
    else
        log "everything already healthy - nothing to do"
    fi
else
    log "composer still not up - leaving lightdm alone"
fi

exit 0
