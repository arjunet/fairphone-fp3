#!/bin/sh

# ginna: chrony.service runs as User=_chrony, a system user normally created
# by adduser in chrony's postinst - which never runs, since this device's
# rootfs-overrides mechanism unpacks .deb payloads directly with dpkg-deb -x
# and skips all maintainer scripts. Without it chrony.service fails to start
# (systemd exit 217/USER). systemd-sysusers is the standard declarative tool
# for exactly this case; run it here (synchronously, in the foreground) so it
# has completed before chrony.service - ordered After=device-hacks.service,
# see overlay/system/usr/lib/systemd/system/chrony.service.d/ - ever tries to
# start. Idempotent: safe to run every boot even once the user exists.
if command -v systemd-sysusers >/dev/null 2>&1; then
  systemd-sysusers /usr/libexec/ginna-chrony-sysusers.conf
elif [ -x /usr/lib/systemd/systemd-sysusers ]; then
  /usr/lib/systemd/systemd-sysusers /usr/libexec/ginna-chrony-sysusers.conf
fi

# Wait for the property system to be up.
while [ ! -e /dev/socket/property_service ]; do sleep 0.1; done

# Enable WIFI
while [ ! -e /dev/wcnss_wlan ]; do sleep 0.2; done
echo 1 > /dev/wcnss_wlan

# ginna: nothing drives the panel backlight at boot, so the compositor comes up
# fully but the screen stays dark. Kick it to a visible level and make the node
# group-writable so repowerd can manage brightness (dim/off) afterwards.
for _bl in /sys/class/leds/lcd-backlight /sys/class/backlight/panel0-backlight \
           /sys/class/backlight/*; do
  [ -e "$_bl/brightness" ] || continue
  chgrp system "$_bl/brightness" 2>/dev/null
  chmod 0664 "$_bl/brightness" 2>/dev/null
  if [ -r "$_bl/max_brightness" ]; then
    cat "$_bl/max_brightness" > "$_bl/brightness" 2>/dev/null
  else
    echo 255 > "$_bl/brightness" 2>/dev/null
  fi
  break
done

# ginna: recover the graphics composer from the early-boot /dev/vndbinder binder
# race (vndservicemanager never becomes that context's manager -> IComposer never
# registers -> black screen). Backgrounded so it never blocks container bring-up.
[ -x /usr/libexec/halium-hal-recover ] && /usr/libexec/halium-hal-recover >/var/log/halium-hal-recover.log 2>&1 &

# Enable fix audio mic service, if disabled, which should
# only happen on first boot or maybe after an OTA-update
if ! systemctl --global -q is-enabled check-audio-mic.service; then
  echo "device-hacks script: enable and start check-audio-mic.service";
  # needs system writable to apply symlink on enabling service
  mount -o rw,remount /
  systemctl --global enable check-audio-mic.service
  systemctl --global start check-audio-mic.service
  # remount read only!
  mount -o ro,remount /
else
  echo "device-hacks script: check-audio-mic.service already enabled";
fi
