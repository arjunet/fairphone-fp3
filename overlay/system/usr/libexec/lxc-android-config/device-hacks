#!/bin/sh

# Wait for the property system to be up.
while [ ! -e /dev/socket/property_service ]; do sleep 0.1; done

# Enable WIFI
while [ ! -e /dev/wcnss_wlan ]; do sleep 0.2; done
echo 1 > /dev/wcnss_wlan

# ginna: nothing drives the panel backlight at boot, so the compositor comes up
# fully but the screen stays dark. Kick it to a visible level and make the node
# group-writable so repowerd can manage brightness (dim/off) afterwards.
for _bl in /sys/class/leds/lcd-backlight /sys/class/backlight/panel0-backlight \
           /sys/class/backlight/*; do
  [ -e "$_bl/brightness" ] || continue
  chgrp system "$_bl/brightness" 2>/dev/null
  chmod 0664 "$_bl/brightness" 2>/dev/null
  if [ -r "$_bl/max_brightness" ]; then
    cat "$_bl/max_brightness" > "$_bl/brightness" 2>/dev/null
  else
    echo 255 > "$_bl/brightness" 2>/dev/null
  fi
  break
done

# ginna: recover the graphics composer from the early-boot /dev/vndbinder binder
# race (vndservicemanager never becomes that context's manager -> IComposer never
# registers -> black screen). Backgrounded so it never blocks container bring-up.
[ -x /usr/libexec/halium-hal-recover ] && /usr/libexec/halium-hal-recover >/var/log/halium-hal-recover.log 2>&1 &

# ginna: install any preinstalled apps baked into the image
# (usr/share/ginna-preinstalled-clicks/*.click) that aren't on
# /opt/click.ubuntu.com yet - see usr/libexec/ginna-preinstall-clicks for why
# this runs the real click install/register instead of faking click's own
# package-database state. Then re-register every click's desktop hook
# (ginna-click-resync), which desktop hooks don't survive a reboot on ginna -
# see that script for why. Neither script's own systemd unit enablement
# actually takes effect through this repo's overlay merge (same class of bug
# as ginna-timesync before it: the merged *.target.wants/ symlink lands
# 'disabled' on-device, and a lightdm.service.d Wants= drop-in was also
# confirmed not to fire it), so this device-hacks call - the one hook proven
# to run every boot on ginna - is the only thing that actually runs
# click-resync every boot, not just the first one after install. Sequenced
# in one subshell (not two independent backgrounded jobs) so click-resync
# sees whatever preinstall-clicks just installed instead of a snapshot from
# before it finished. Backgrounded as a pair: installing a dozen apps plus
# up to ~3 minutes of click-resync's own desktop-file retries takes a while,
# and device-hacks.service is KillMode=process so it survives past this
# script's own exit.
( [ -x /usr/libexec/ginna-preinstall-clicks ] && /usr/libexec/ginna-preinstall-clicks >/var/log/ginna-preinstall-clicks.log 2>&1
  [ -x /usr/libexec/ginna-click-resync ] && /usr/libexec/ginna-click-resync >/var/log/ginna-click-resync.log 2>&1 ) &


# Enable fix audio mic service, if disabled, which should
# only happen on first boot or maybe after an OTA-update
if ! systemctl --global -q is-enabled check-audio-mic.service; then
  echo "device-hacks script: enable and start check-audio-mic.service";
  # needs system writable to apply symlink on enabling service
  mount -o rw,remount /
  systemctl --global enable check-audio-mic.service
  systemctl --global start check-audio-mic.service
  # remount read only!
  mount -o ro,remount /
else
  echo "device-hacks script: check-audio-mic.service already enabled";
fi
